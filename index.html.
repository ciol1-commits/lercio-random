
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Lercio Random</title>
</head>
<body>
  <p id="msg">Sto cercando una notizia assurda...</p>

  <script>
    (async function () {
      const msg = document.getElementById("msg");

      try {
        const url =
          "https://www.lercio.it/wp-json/wp/v2/posts" +
          "?per_page=20&_fields=link&orderby=date&order=desc";

        const risposta = await fetch(url, { cache: "no-store" });

        if (!risposta.ok) {
          throw new Error("Lercio ha risposto con errore HTTP " +
            risposta.status);
        }

        const articoli = await risposta.json();

        if (!Array.isArray(articoli) || articoli.length === 0) {
          throw new Error("Il feed non contiene articoli");
        }

        const articolo =
          articoli[Math.floor(Math.random() * articoli.length)];

        if (!articolo.link) {
          throw new Error("Link articolo mancante");
        }

        msg.textContent = "Trovata! Ti porto su Lercio...";
        window.location.replace(articolo.link);

      } catch (errore) {
        msg.textContent =
          "Errore: " + errore.message +
          ". Prova ad aprire il feed di Lercio direttamente.";
        console.error(errore);
      }
    })();
  </script>
</body>
</html>
